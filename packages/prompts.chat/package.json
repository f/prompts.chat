{
  "name": "prompts.chat",
  "version": "0.2.0",
  "description": "Developer toolkit and CLI for prompts.chat - browse prompts, skills, bots and teams, and build, validate and parse prompts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prompts-chat": "./bin/cli.js",
    "prompts.chat": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./variables": {
      "import": {
        "types": "./dist/variables/index.d.ts",
        "default": "./dist/variables/index.js"
      },
      "require": {
        "types": "./dist/variables/index.d.cts",
        "default": "./dist/variables/index.cjs"
      }
    },
    "./similarity": {
      "import": {
        "types": "./dist/similarity/index.d.ts",
        "default": "./dist/similarity/index.js"
      },
      "require": {
        "types": "./dist/similarity/index.d.cts",
        "default": "./dist/similarity/index.cjs"
      }
    },
    "./quality": {
      "import": {
        "types": "./dist/quality/index.d.ts",
        "default": "./dist/quality/index.js"
      },
      "require": {
        "types": "./dist/quality/index.d.cts",
        "default": "./dist/quality/index.cjs"
      }
    },
    "./builder": {
      "import": {
        "types": "./dist/builder/index.d.ts",
        "default": "./dist/builder/index.js"
      },
      "require": {
        "types": "./dist/builder/index.d.cts",
        "default": "./dist/builder/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.ts",
        "default": "./dist/parser/index.js"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "prompts",
    "chatgpt",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "prompt-engineering",
    "prompt-templates",
    "prompt-builder",
    "cli",
    "skills",
    "agents",
    "bots"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/f/prompts.chat"
  },
  "homepage": "https://prompts.chat",
  "author": "Fatih Kadir Akın <fatihkadirakin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "npx ts-node scripts/generate-docs.ts",
    "docs:generate": "npx tsx scripts/generate-docs.ts",
    "prepack": "npm run build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:live": "PROMPTS_CHAT_LIVE=1 vitest run src/cli/__tests__/live.test.ts"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "react": "^18.3.1",
    "clipboardy": "^4.0.0",
    "meow": "^13.2.0",
    "open": "^10.1.0",
    "terminal-image": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
